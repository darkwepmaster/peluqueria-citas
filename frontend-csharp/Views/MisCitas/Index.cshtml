@model List<CitaDto>
@{
    ViewData["Title"] = "Mis citas";
    var proximas = Model.Where(c => c.EsActiva && c.Fecha >= DateOnly.FromDateTime(DateTime.Today)).OrderBy(c => c.Fecha).ThenBy(c => c.HoraInicio).ToList();
    var historial = Model.Except(proximas).ToList();
}
<h1>Mis citas</h1>
<p class="sub">Consulta, reprograma o cancela tus reservas</p>
<h3>Próximas (@proximas.Count)</h3>
@if (!proximas.Any()) { <p class="sub">No tienes citas próximas. <a asp-controller="Catalogo" asp-action="Index">Reserva una ahora</a>.</p> }
@foreach (var c in proximas)
{
    <div class="card fila">
        <div><b>@c.Descripcion</b><p class="sub">@c.EstilistaNombre · @Fmt.Fecha(c.Fecha) · @Fmt.Hora(c.HoraInicio)</p></div>
        <div class="fila"><partial name="_Estado" model="c.Estado" />
            <a class="btn o s" asp-action="Reprogramar" asp-route-id="@c.Id">Reprogramar</a>
            <details class="modal-lite"><summary class="btn d s">Cancelar</summary>
                <form asp-action="Cancelar" method="post" class="caja">
                    <p><b>¿Cancelar esta cita?</b> El horario quedará libre para otros clientes.</p>
                    <input type="hidden" name="id" value="@c.Id" />
                    <label>Motivo (opcional)</label><input name="motivo" class="in" maxlength="200" />
                    <button class="btn d s" type="submit">Sí, cancelar cita</button>
                </form></details></div>
    </div>
}
<h3>Historial (@historial.Count)</h3>
<div class="card sin-pad"><table>
    <tr><th>Fecha</th><th>Servicio</th><th>Estilista</th><th>Estado</th><th>Total</th></tr>
    @foreach (var c in historial) { <tr><td>@Fmt.Fecha(c.Fecha) @Fmt.Hora(c.HoraInicio)</td><td>@c.Descripcion</td><td>@c.EstilistaNombre</td><td><partial name="_Estado" model="c.Estado" /></td><td>@Fmt.Dinero(c.Total)</td></tr> }
</table></div>
