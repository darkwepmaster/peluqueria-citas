<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>${PATRON}</pattern></encoder></appender>
    <!-- Registro general con rotación diaria y por tamaño -->
    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/peluqueria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/peluqueria.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize><maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>
    <!-- Bitácora de auditoría: solo identificadores, nunca contraseñas ni datos personales completos -->
    <appender name="AUDITORIA" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/auditoria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/auditoria.%d{yyyy-MM}.log</fileNamePattern><maxHistory>12</maxHistory>
        </rollingPolicy>
        <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss} %msg%n</pattern></encoder>
    </appender>
    <logger name="AUDITORIA" level="INFO" additivity="false"><appender-ref ref="AUDITORIA"/></logger>
    <root level="INFO"><appender-ref ref="CONSOLA"/><appender-ref ref="ARCHIVO"/></root>
</configuration>
